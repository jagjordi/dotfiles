#!/bin/zsh
#
# .zshrc - Zsh file loaded on interactive shell sessions.
#

# Zsh options.
setopt extended_glob

# Autoload functions you might want to use with antidote.
ZFUNCDIR=${ZFUNCDIR:-$ZDOTDIR/functions}
fpath=($ZFUNCDIR $fpath)
autoload -Uz $fpath[1]/*(.:t)

# Source zstyles you might use with antidote.
[[ -e ${ZDOTDIR:-~}/.zstyles ]] && source ${ZDOTDIR:-~}/.zstyles

# Clone antidote if necessary.
[[ -d ${ZDOTDIR:-~}/.antidote ]] ||
  git clone https://github.com/mattmc3/antidote ${ZDOTDIR:-~}/.antidote

# Create an amazing Zsh config using antidote plugins.
source ${ZDOTDIR:-~}/.antidote/antidote.zsh
antidote load

# ignore sshfs directory
FZF_CTRL_T_COMMAND='fd --hidden --follow'
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

export PATH=${HOME}/.cargo/bin:${PATH}
export PATH="$HOME/.local/bin:$PATH"

# bun: prefer the userspace install; the pacman /usr/bin/bun (1.4.0-1) is
# linked against GLIBC_2.44 and this system has 2.43, so it cannot run.
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# bun completions
[ -s "/home/jordi/.bun/_bun" ] && source "/home/jordi/.bun/_bun"

# OpenClaw Completion
[ -f '/home/jordi/.openclaw/completions/openclaw.zsh' ] && source '/home/jordi/.openclaw/completions/openclaw.zsh'
