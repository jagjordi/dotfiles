#!/bin/zsh
#
# .zshenv - Zsh environment file, loaded always.
#

# NOTE: .zshenv needs to live at ~/.zshenv, not in $ZDOTDIR!

# Set ZDOTDIR if you want to re-home Zsh.
export XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
export ZDOTDIR=${ZDOTDIR:-$XDG_CONFIG_HOME/zsh}

# Eanable env-modules
((${+functions[module]})) || source /etc/modules/init/zsh
export MODULEPATH=${MODULEPATH}:~/.config/modules

# You can use .zprofile to set environment vars for non-login, non-interactive shells.
if [[ ( "$SHLVL" -eq 1 && ! -o LOGIN ) && -s "${ZDOTDIR:-$HOME}/.zprofile" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprofile"
fi
# Sourced by every zsh (interactive, login, script, systemd user unit, cron),
# unlike .zshrc which is interactive-only. PATH belongs here so that
# `ssh host 'openclaw ...'` and non-interactive callers resolve it too.
#
# typeset -U keeps `path` deduplicated, so nested shells re-prepending
# this entry cannot grow PATH without bound.
typeset -U path PATH
path=("$HOME/.npm-global/bin" $path)
export PATH
